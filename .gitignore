# =========================
# Java / Maven
# =========================
target/
**/target/
*.class
*.jar
*.war
*.ear

# Keep Maven Wrapper files if they are added later.
!.mvn/wrapper/maven-wrapper.jar

# Maven generated reports and local metadata
**/dependency-reduced-pom.xml
release.properties
pom.xml.asc

# =========================
# Spring Boot / application data
# =========================
*.log
logs/
**/logs/
application-local.yml
application-local.yaml
application-*.local.yml
application-*.local.yaml
*.secret
*.secrets

# Local uploads and runtime-generated files
uploads/
**/uploads/
*.pid
*.tmp

